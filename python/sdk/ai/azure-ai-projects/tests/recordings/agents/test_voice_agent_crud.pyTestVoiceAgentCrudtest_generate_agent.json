                    "rate": 24000
                  },
                  "voice": "en-US-Emma:DragonHDLatestNeural",
                  "voice_type": "azure-standard"
                }
              },
              "greeting": {
                "type": "template",
                "text": "Hello, I am a general phone assistant. I can help think through a question, organize details, or plan a next step. What would you like help with?"
              }
