        "response": [
          {
            "content": [
              {
                "type": "text",
                "text": "[{\"ref_id\":0,\"title\":\"Fancy Stay\",\"terms\":\"Luxury\",\"content\":\"Best hotel in town if you like luxury hotels. They have an amazing infinity pool, a spa, and a really helpful concierge. The location is perfect -- right downtown, close to all the tourist attractions. We highly recommend this hotel.\"},{\"ref_id\":1,\"title\":\"Countryside Hotel\",\"terms\":\"Budget\",\"content\":\"Save up to 50% off traditional hotels.  Free WiFi, great location near downtown, full kitchen, washer & dryer, 24/7 support, bowling alley, fitness center and more.\"},{\"ref_id\":2,\"title\":\"Secret Point Motel\",\"terms\":\"Boutique\",\"content\":\"The hotel is ideally located on the main commercial artery of the city in the heart of New York. A few minutes away is Time's Square and the historic centre of the city, as well as other places of interest that make New York one of America's most attractive and cosmopolitan cities.\"},{\"ref_id\":3,\"title\":\"EconoStay\",\"terms\":\"Budget\",\"content\":\"Very popular hotel in town\"},{\"ref_id\":4,\"title\":\"Comfy Place\",\"terms\":\"Budget\",\"content\":\"Another good hotel\"},{\"ref_id\":5,\"title\":\"Express Rooms\",\"terms\":\"Budget\",\"content\":\"Pretty good hotel\"},{\"ref_id\":6,\"title\":\"Roach Motel\",\"terms\":\"Budget\",\"content\":\"Cheapest hotel in town. Infact, a motel.\"}]"
